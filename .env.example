# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Opcional: ID do seu servidor para os comandos aparecerem na hora (sem isso pode levar até 1h)
GUILD_ID=
# Agenda da coleta (padrão: domingo 04:00 de Brasília, um domingo sim e outro não)
UPDATE_TZ=America/Sao_Paulo
UPDATE_WEEKDAY=6        # 0=segunda ... 6=domingo
UPDATE_HOUR=4
UPDATE_EVERY_WEEKS=2    # 1 = todo domingo, 2 = quinzenal
# Regiões coletadas: kr (Coreia) e globais naw, nae, eu, la, as
REGIONS=kr,naw,nae,eu,la,as
# Quantos tops por classe entram no cálculo do meta
TOP_N=15
# Intervalo mínimo entre requisições à NC (segundos) — não abaixe muito
REQUEST_INTERVAL=0.35
# DB_PATH=aion2.db   (no Railway deixe vazio: o bot usa o volume sozinho)
LOG_LEVEL=INFO
